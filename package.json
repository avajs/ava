{
	"name": "ava",
	"version": "8.1.0",
	"description": "Node.js test runner that lets you develop with confidence.",
	"license": "MIT",
	"repository": "github:avajs/ava",
	"homepage": "https://avajs.dev",
	"type": "module",
	"exports": {
		".": {
			"types": "./entrypoints/main.d.ts",
			"default": "./entrypoints/main.js"
		},
		"./eslint-plugin-helper": "./entrypoints/eslint-plugin-helper.js",
		"./plugin": {
			"types": "./entrypoints/plugin.d.ts",
			"default": "./entrypoints/plugin.js"
		},
		"./internal": {
			"types": "./entrypoints/internal.d.ts"
		}
	},
	"bin": {
		"ava": "./entrypoints/cli.js"
	},
	"engines": {
		"node": "^22.20 || ^24.12 || >=26"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.11.1",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12",
			"onFail": "download"
		}
	},
	"scripts": {
		"test": "./scripts/test.sh"
	},
	"files": [
		"*.d.ts",
		"entrypoints",
		"lib",
		"types"
	],
	"keywords": [
		"🦄",
		"test",
		"runner",
		"testing",
		"concurrent",
		"parallel",
		"fast",
		"tdd",
		"cli-app",
		"cli",
		"jest",
		"mocha",
		"tape",
		"tap",
		"qunit",
		"jasmine",
		"assert",
		"assertion",
		"promise",
		"promises",
		"async",
		"function",
		"await",
		"generator",
		"generators",
		"yield",
		"observable",
		"observables",
		"unit",
		"snapshot",
		"expect",
		"typescript"
	],
	"dependencies": {
		"@vercel/nft": "^1.11.0",
		"acorn": "^8.19.0",
		"acorn-walk": "^8.3.5",
		"ansi-styles": "^7.0.0",
		"arrgv": "^1.0.2",
		"arrify": "^3.0.0",
		"callsites": "^4.2.0",
		"cbor2": "^2.4.0",
		"chalk": "^6.0.1",
		"chunkd": "^2.0.1",
		"ci-info": "^4.4.0",
		"ci-parallel-vars": "^1.0.1",
		"cli-truncate": "^6.1.1",
		"code-excerpt": "^4.0.0",
		"common-path-prefix": "^3.0.0",
		"concordance": "^5.0.4",
		"currently-unhandled": "^0.4.1",
		"debug": "^4.4.3",
		"emittery": "^2.1.0",
		"figures": "^6.1.0",
		"globby": "^16.2.4",
		"ignore-by-default": "^2.1.0",
		"indent-string": "^5.0.0",
		"is-plain-object": "^5.1.0",
		"is-promise": "^4.0.0",
		"matcher": "^7.0.0",
		"memoize": "^11.0.0",
		"ms": "^2.1.3",
		"p-map": "^7.1.1",
		"package-config": "^5.0.0",
		"picomatch": "^4.0.7",
		"plur": "^6.0.0",
		"pretty-ms": "^9.3.1",
		"resolve-cwd": "^3.0.0",
		"slash": "^5.1.0",
		"stack-utils": "^2.0.6",
		"supertap": "^3.0.1",
		"temp-dir": "^3.0.0",
		"write-file-atomic": "^7.0.1",
		"yargs": "^18.2.0"
	},
	"devDependencies": {
		"@ava/test": "github:avajs/test",
		"@ava/typescript": "^7.0.0",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/node": "^26.6.5",
		"ansi-escapes": "^7.3.0",
		"c8": "^12.0.0",
		"eslint-plugin-ava": "^18.0.0",
		"execa": "^10.1.0",
		"expect": "^30.5.2",
		"sinon": "^22.1.0",
		"tap": "^21.8.0",
		"tempy": "^3.2.0",
		"tsd": "^0.33.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1",
		"zen-observable": "^0.10.0"
	},
	"peerDependencies": {
		"@ava/typescript": "*"
	},
	"peerDependenciesMeta": {
		"@ava/typescript": {
			"optional": true
		}
	}
}
